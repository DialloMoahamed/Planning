+  .sheet button { width:100%; text-align:left; padding:13px 14px; }
+  .toast { display:block; position:fixed; left:50%; transform:translateX(-50%) translateY(10px); bottom:calc(92px + env(safe-area-inset-bottom, 0px));
+    max-width:calc(100% - 32px); background:var(--panel2); border:1px solid var(--accent); color:var(--text); padding:10px 14px; border-radius:12px;
+    font-size:.88rem; opacity:0; pointer-events:none; transition:opacity .2s, transform .2s; z-index:25; }
+  .toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
+}
